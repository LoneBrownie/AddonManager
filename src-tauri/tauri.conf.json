{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brownie\u2019s Addon Manager",
  "version": "2.2.0",
  "identifier": "com.lonebrownie.browniesaddonmanager.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Brownie\u2019s Addon Manager",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Manage WoW addons across multiple servers",
    "longDescription": "Install and update World of Warcraft addons from GitHub and GitLab across several game folders.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://lonebrownie.github.io/AddonManager/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MEQxRTMyNkU5NDYwMjUKUldRbFlKUnVNaDROTmM5bDIvWWZlVGl0eHZqMGVKbHZFVTR0YU5RdEcvOXlzQ1JPRUFlYzlXRGoK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
