{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brownie's Addon Manager",
  "version": "2.0.0",
  "identifier": "com.lonebrownie.browniesaddonmanager.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Brownie's Addon Manager",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Manage WoW addons across multiple servers",
    "longDescription": "Install and update World of Warcraft addons from GitHub and GitLab across several game folders."
  }
}
